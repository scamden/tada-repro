{
  "extends": "@vtp/rig/tsconfig.json",
  "compilerOptions": {
    // uncomment this to fix the tada warnings
    // "moduleResolution": "nodenext",
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./src/schema.graphql",
        "tadaOutputLocation": "./src/graphql-env.d.ts",
      }
    ]
  },
  "include": ["src/**/*"]
} 